[1.427069, "o", "Path (3 steps): \u001b[1mMaximumIndependentSet/SimpleGraph/One\u001b[0m \u001b[32m\u2192\u001b[39m \u001b[1mMaximumSetPacking/One\u001b[0m \u001b[32m\u2192\u001b[39m \u001b[1mILP/bool\u001b[0m\r\n\r\n  \u001b[36mStep 1\u001b[39m: \u001b[1mMaximumIndependentSet/SimpleGraph/One\u001b[0m \u001b[32m\u2192\u001b[39m \u001b[1mMaximumSetPacking/One\u001b[0m\r\n    num_sets = O(num_vertices)\r\n    universe_size = O(num_edges)\r\n\r\n  \u001b[36mStep 2\u001b[39m: \u001b[1mMaximumSetPacking/One\u001b[0m \u001b[32m\u2192\u001b[39m \u001b[1mMaximumSetPacking/i32\u001b[0m\r\n    num_sets = O(num_sets)\r\n    universe_size = O(universe_size)\r\n\r\n  \u001b[36mStep 3\u001b[39m: \u001b[1mMaximumSetPacking/i32\u001b[0m \u001b[32m\u2192\u001b[39m \u001b[1mILP/bool\u001b[0m\r\n    num_vars = O(num_sets)\r\n    num_constraints = O(universe_size)\r\n\r\n  \u001b[36mOverall\u001b[39m:\r\n    num_vars = O(num_vertices)\r\n    num_constraints = O(num_edges)\r\n\r\n"]

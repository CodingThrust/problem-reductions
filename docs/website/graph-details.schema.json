{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codingthrust.github.io/problem-reductions/contracts/graph-details",
  "title": "GraphDetailsIndex",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries", "anchors"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "entries": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^(problem:.+|rule:.+|references|footnotes)$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "anchors": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
  }
}

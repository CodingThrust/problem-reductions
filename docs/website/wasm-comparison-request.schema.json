{
  "$id": "https://codingthrust.github.io/problem-reductions/contracts/wasm-comparison-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ComparisonQuery",
  "type": "object",
  "properties": {
    "graph": {
      "$ref": "#/$defs/Graph"
    },
    "paths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Route"
      }
    }
  },
  "required": [
    "graph",
    "paths"
  ],
  "$defs": {
    "Contract": {
      "type": "string",
      "enum": [
        "exact",
        "upper_bound",
        "unavailable"
      ]
    },
    "Edge": {
      "type": "object",
      "properties": {
        "parameter_contract_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Parameter"
          }
        },
        "source": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "target": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "turing": {
          "type": "boolean"
        },
        "witness": {
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "target",
        "witness",
        "turing",
        "parameters"
      ]
    },
    "Endpoint": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "variant": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "variant"
      ]
    },
    "Graph": {
      "type": "object",
      "properties": {
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Edge"
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Node"
          }
        }
      },
      "required": [
        "nodes",
        "edges"
      ]
    },
    "Node": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "parameter_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "variant": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "variant",
        "parameter_names"
      ]
    },
    "Parameter": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/$defs/Contract"
        },
        "field": {
          "type": "string"
        },
        "formula": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "field",
        "contract"
      ]
    },
    "Route": {
      "type": "object",
      "properties": {
        "path": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          },
          "minItems": 1
        },
        "steps": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "steps",
        "path"
      ]
    },
    "Step": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/Endpoint"
        },
        "to": {
          "$ref": "#/$defs/Endpoint"
        }
      },
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codingthrust.github.io/problem-reductions/contracts/path-worker-reply",
  "title": "PathReplyEnvelope",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "phase", "result"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "phase": {"type": "string", "const": "paths"},
        "result": {}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "phase", "result"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "phase": {"type": "string", "const": "comparison"},
        "result": {}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "phase", "error"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "phase": {"type": "string", "enum": ["paths", "comparison"]},
        "error": {"type": "string", "minLength": 1}
      }
    }
  ]
}
